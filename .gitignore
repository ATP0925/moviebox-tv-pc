# Dependencies
node_modules/
package-lock.json

# Large Archives & Binaries
*.zip
*.tar.gz
*.7z
android_build/

# Allow Official Platform Download APKs and PWA Icons
!downloads/**/*.apk
!downloads/*.apk
!app/public/downloads/**/*.apk
!app/public/downloads/*.apk
!app/public/icons/*.png

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.log

# Decompiled APK Trees
decompiled/
decompiled_interceptor/
decompiled_manifest/
decompiled_sign/

# Screenshots & Local Cache
*.png
!screenshots/*.png
!app/public/icons/*.png
.vscode/
.idea/
